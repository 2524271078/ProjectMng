# Copy this file to .env and fill in the PostgreSQL password locally.
DB_ENGINE=postgresql
POSTGRES_DB=project_mng
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DEBUG=false
SECRET_KEY=请替换为随机长字符串
LICENSE_ENFORCEMENT_ENABLED=true
LICENSE_OPERATOR_USERNAME=xushaotai
LICENSE_PUBLIC_KEY_PATH=/opt/projectmng/backend/licensing/public_key.pem

# Feishu SMTP server connection settings.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.feishu.cn
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
# SMTP 登录账号、授权码和默认发件邮箱在“维保邮件提醒 > 邮件配置”中维护。
