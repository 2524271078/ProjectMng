# Copy this file to .env and fill in the PostgreSQL password locally.
DB_ENGINE=postgresql
POSTGRES_DB=project_mng
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DEBUG=false
SECRET_KEY=请替换为随机长字符串
LICENSE_ENFORCEMENT_ENABLED=true
LICENSE_OPERATOR_USERNAME=xushaotai
LICENSE_PUBLIC_KEY_PATH=/opt/projectmng/backend/licensing/public_key.pem

# Feishu SMTP. Use an app-specific password, not the account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.feishu.cn
EMAIL_PORT=465
EMAIL_HOST_USER=your-account@example.com
EMAIL_HOST_PASSWORD=your-feishu-app-password
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=your-account@example.com
